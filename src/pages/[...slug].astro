---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSiblingLinks } from '../helpers/navLinks.js';
import { makeReadableName } from '../helpers/makeReadableNameFromPath.js';

// Every file in src/content becomes a page at the matching URL, exactly like
// the old src/routes tree under Sapper. A folder's index page is served at
// the folder's own URL and receives links to its sibling pages (what the old
// index.json.js endpoints provided).
export async function getStaticPaths() {
  const modules = import.meta.glob('../content/**/*.{svx,svelte}', {
    eager: true,
  });

  const paths = [];
  for (const [file, mod] of Object.entries(modules)) {
    const route = file
      .replace('../content/', '')
      .replace(/\.(svx|svelte)$/, '');

    // These routes have dedicated pages in src/pages.
    if (route === 'index') continue;
    if (route === 'contents/japan/dancing-phantoms-from-japan') continue;

    const isFolderIndex = route.endsWith('/index');
    const folderRoute = isFolderIndex ? route.slice(0, -'/index'.length) : null;
    const slug = isFolderIndex ? folderRoute : route;

    // The <title> and meta description come from the page's own metadata:
    // YAML frontmatter in .svx files (mdsvex exports it as `metadata`) or an
    // `export const metadata = {...}` module script in .svelte files. A page
    // without one still gets a unique title derived from its file name.
    const metadata = mod.metadata ?? {};

    paths.push({
      params: { slug },
      props: {
        Content: mod.default,
        title: metadata.title ?? makeReadableName(slug.split('/').at(-1)),
        description: metadata.description,
        links: isFolderIndex ? getSiblingLinks(folderRoute) : undefined,
      },
    });
  }
  return paths;
}

const { Content, links, title, description } = Astro.props;
---

<BaseLayout {title} {description}>
  <Content {links} currentPath={Astro.url.pathname} />
</BaseLayout>
