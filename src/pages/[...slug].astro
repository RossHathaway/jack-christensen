---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSiblingLinks } from '../helpers/navLinks.js';
import { makeReadableName } from '../helpers/makeReadableNameFromPath.js';

// Every MDX file in src/content becomes a page at the matching URL, exactly
// like the old src/routes tree under Sapper. A folder's index page is served
// at the folder's own URL and receives links to its sibling pages (what the
// old index.json.js endpoints provided).
export async function getStaticPaths() {
  const modules = import.meta.glob('../content/**/*.mdx', {
    eager: true,
  });

  const paths = [];
  for (const [file, mod] of Object.entries(modules)) {
    const route = file.replace('../content/', '').replace(/\.mdx$/, '');

    // These routes have dedicated pages in src/pages.
    if (route === 'index') continue;
    if (route === 'contents/japan/dancing-phantoms-from-japan') continue;

    const isFolderIndex = route.endsWith('/index');
    const folderRoute = isFolderIndex ? route.slice(0, -'/index'.length) : null;
    let slug = isFolderIndex ? folderRoute : route;

    // A page named after its own folder (about-uncle-jack/about-uncle-jack)
    // is that folder's page, served at the folder's URL rather than with the
    // segment repeated.
    const segments = route.split('/');
    if (!isFolderIndex && segments.length > 1 && segments.at(-1) === segments.at(-2)) {
      slug = segments.slice(0, -1).join('/');
    }

    // The <title> and meta description come from the page's YAML frontmatter
    // (MDX exports it as `frontmatter`). A page without one still gets a
    // unique title derived from its file name.
    const frontmatter = mod.frontmatter ?? {};

    // Per-page styles live in a .css file imported by the page's MDX and are
    // scoped by this class on the page's wrapper element (the replacement
    // for mdsvex's Svelte-scoped <style> blocks). Folder index pages are
    // scoped by the folder name — never `page-index`, which belongs to the
    // home page: Astro can bundle several pages' styles into one shared
    // stylesheet, so a shared class name would leak styles across pages.
    const pageClass = `page-${slug.split('/').at(-1)}`;

    paths.push({
      params: { slug },
      props: {
        Content: mod.default,
        pageClass,
        title: frontmatter.title ?? makeReadableName(slug.split('/').at(-1)),
        description: frontmatter.description,
        links: isFolderIndex ? getSiblingLinks(folderRoute) : undefined,
      },
    });
  }
  return paths;
}

const { Content, pageClass, links, title, description } = Astro.props;
---

<BaseLayout {title} {description}>
  <div class:list={['page', pageClass]}>
    <Content {links} currentPath={Astro.url.pathname} />
  </div>
</BaseLayout>
